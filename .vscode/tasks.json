{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Signal Backend (FastAPI)",
      "type": "shell",
      "command": "./venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Signal Frontend (Next.js)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Start Signal Application (Fullstack)",
      "dependsOn": ["Start Signal Backend (FastAPI)", "Start Signal Frontend (Next.js)"],
      "problemMatcher": []
    }
  ]
}
