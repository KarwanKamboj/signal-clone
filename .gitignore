# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Frontend dependencies and Next.js output
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/

# Python virtual environments and cache
backend/venv/
backend/.venv/
backend/env/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/

# SQLite databases created locally
backend/*.db
*.db
*.sqlite3

# Environment secrets
.env
.env.*
frontend/.env.local
backend/.env

# Keep safe environment templates in Git
!.env.example
!frontend/.env.local.example
!backend/.env.example

# User-uploaded files
backend/uploads/*

# Editor and operating-system files
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*